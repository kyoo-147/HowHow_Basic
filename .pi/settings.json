{
  "packages": ["npm:pi-subagents@0.55.0"],
  "agentDirectories": [".pi/agents"],
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "medium",
    "agentOverrides": {
      "delegate": {"model": "openai-codex/gpt-5.6-luna", "thinking": "medium"},
      "oracle": {"model": "openai-codex/gpt-5.6-luna", "thinking": "medium"},
      "researcher": {"model": "openai-codex/gpt-5.6-luna", "thinking": "medium"},
      "reviewer": {"model": "openai-codex/gpt-5.6-luna", "thinking": "medium"},
      "scout": {"model": "openai-codex/gpt-5.6-luna", "thinking": "medium"},
      "worker": {"model": "openai-codex/gpt-5.6-luna", "thinking": "medium"}
    },
    "modelScope": {"enforce": true, "allow": ["openai-codex/gpt-5.6-luna"]}
  }
}
